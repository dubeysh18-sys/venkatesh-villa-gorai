{
  "name": "venkatesh-villa-gorai",
  "version": "1.0.0",
  "private": true,
  "description": "One-page, SEO-first website for Venkatesh Villa Gorai",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "presite": "node scripts/sync-gallery.mjs && node scripts/generate-og-image.mjs",
    "start": "npm run presite && eleventy --serve --incremental",
    "build": "npm run presite && eleventy",
    "prebuild-check": "npm run build",
    "check:html": "html-validate \"_site/**/*.html\"",
    "check:links": "linkinator _site --silent --skip \"https://.*\"",
    "check:lhci": "lhci autorun",
    "check": "npm run check:html && npm run check:links",
    "check:full": "npm run check && npm run check:lhci"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.7",
    "@11ty/eleventy-img": "7.1.1",
    "@fontsource/inter": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@lhci/cli": "0.15.1",
    "clean-css": "5.3.3",
    "html-validate": "11.17.0",
    "linkinator": "8.1.0",
    "sharp": "0.35.5"
  }
}
