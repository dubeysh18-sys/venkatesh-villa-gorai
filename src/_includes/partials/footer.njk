<footer class="site-footer">
  <div class="container site-footer__inner">
    <div>
      <address class="nap">
        <strong>{{ site.name }}</strong><br>
        {{ site.address.displayLine }}<br>
        <a href="tel:{{ site.phoneE164 }}">{{ site.phoneDisplay }}</a>
      </address>
      <nav class="site-footer__social" aria-label="Social and listing links">
        {% if site.instagram | isSet %}
        <a href="{{ site.instagram }}" target="_blank" rel="noopener">Instagram</a>
        {% endif %}
        <a href="{{ site.googleMapsUrl }}" target="_blank" rel="noopener">Google Maps</a>
        {% if site.airbnbUrl | isSet %}
        <a href="{{ site.airbnbUrl }}" target="_blank" rel="noopener" data-cta="airbnb" data-cta-location="footer">Airbnb</a>
        {% endif %}
      </nav>
      <p>&copy; {{ currentYear }} {{ site.name }}. {{ copy.footer.tagline }}</p>
    </div>
    <nav class="site-footer__links" aria-label="Footer">
      {% for item in copy.nav | filterNav(reviews) %}
      <a href="{{ item.href }}">{{ item.label }}</a>
      {% endfor %}
    </nav>
  </div>
  {% if site.ga4Id | isSet %}
  <div class="container">
    <p class="site-footer__privacy">This site uses Google Analytics to understand how visitors find us. No personal data is sold or shared beyond Google's standard analytics processing.</p>
  </div>
  {% endif %}
</footer>
