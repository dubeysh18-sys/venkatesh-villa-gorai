{#
  Small inline-SVG icon set, drawn in-house to replace the Stitch mockup's
  Material Symbols Outlined font (keeps the JS/font budget down -- see
  DESIGN_NOTES.md "Deviations" #7). 24x24 viewBox, stroke-based, currentColor,
  so every icon inherits its color + size from the surrounding CSS.
  Usage: {{ icons.icon("cake") }}
#}
{% macro icon(name, extraClass="") %}
{#- width/height="24" is a deliberate fallback: an <svg> with only a
    viewBox (no intrinsic size) renders at the browser default of
    300x150 CSS px wherever no CSS rule happens to size it. Every
    specific usage can still override via a CSS width/height rule
    (those win over HTML attributes), but this keeps an unstyled icon
    from ever rendering giant instead of invisible-by-omission. -#}
{%- set common = 'width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"' -%}
{%- if extraClass %}{% set common = common + ' class="' + extraClass + '"' %}{% endif -%}

{%- if name == "menu" -%}
<svg {{ common | safe }}><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg>

{%- elif name == "close" -%}
<svg {{ common | safe }}><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>

{%- elif name == "chat" -%}
<svg {{ common | safe }}><path d="M4 12a8 8 0 1 1 3.2 6.4L4 20l1.3-3.6A7.96 7.96 0 0 1 4 12Z"/><line x1="8.5" y1="11" x2="15.5" y2="11"/><line x1="8.5" y1="14" x2="13" y2="14"/></svg>

{%- elif name == "phone" -%}
<svg {{ common | safe }}><path d="M6 3h3l1.5 4.5L8.5 9.5a12 12 0 0 0 6 6l2-2L21 15v3a2 2 0 0 1-2 2A16 16 0 0 1 4 5a2 2 0 0 1 2-2Z"/></svg>

{%- elif name == "instagram" -%}
<svg {{ common | safe }}><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17" cy="7" r="0.8" fill="currentColor" stroke="none"/></svg>

{%- elif name == "map-pin" -%}
<svg {{ common | safe }}><path d="M12 21s7-6.5 7-12a7 7 0 1 0-14 0c0 5.5 7 12 7 12Z"/><circle cx="12" cy="9" r="2.5"/></svg>

{%- elif name == "arrow-right" -%}
<svg {{ common | safe }}><line x1="4" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg>

{%- elif name == "chevron-left" -%}
<svg {{ common | safe }}><polyline points="15 6 9 12 15 18"/></svg>

{%- elif name == "chevron-right" -%}
<svg {{ common | safe }}><polyline points="9 6 15 12 9 18"/></svg>

{%- elif name == "chevron-down" -%}
<svg {{ common | safe }}><polyline points="6 9 12 15 18 9"/></svg>

{%- elif name == "play" -%}
<svg {{ common | safe }}><polygon points="6 4 20 12 6 20 6 4" fill="currentColor" stroke="none"/></svg>

{%- elif name == "pause" -%}
<svg {{ common | safe }}><rect x="6" y="4" width="4" height="16" fill="currentColor" stroke="none"/><rect x="14" y="4" width="4" height="16" fill="currentColor" stroke="none"/></svg>

{%- elif name == "check-circle" -%}
<svg {{ common | safe }}><circle cx="12" cy="12" r="9"/><polyline points="8 12.5 11 15.5 16 9"/></svg>

{%- elif name == "bed" -%}
<svg {{ common | safe }}><path d="M3 18v-6a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v6"/><path d="M3 18v2M21 18v2"/><path d="M3 13V9a2 2 0 0 1 2-2h5a2 2 0 0 1 2 2v3"/><path d="M12 13V8h7a2 2 0 0 1 2 2v3"/></svg>

{%- elif name == "bath" -%}
<svg {{ common | safe }}><path d="M4 12h16v3a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4v-3Z"/><path d="M4 12V7a2 2 0 0 1 2-2c1 0 2 1 2 2"/><line x1="7" y1="19" x2="7" y2="21"/><line x1="17" y1="19" x2="17" y2="21"/></svg>

{%- elif name == "grass" -%}
<svg {{ common | safe }}><path d="M12 21V11"/><path d="M12 11c0-3 2-5 5-5-0 3-2 5-5 5Z"/><path d="M12 14c0-3-2-5-5-5 0 3 2 5 5 5Z"/><line x1="4" y1="21" x2="20" y2="21"/></svg>

{%- elif name == "gazebo" -%}
<svg {{ common | safe }}><polygon points="12 3 21 8 3 8"/><line x1="5" y1="8" x2="5" y2="19"/><line x1="19" y1="8" x2="19" y2="19"/><line x1="12" y1="8" x2="12" y2="19"/><line x1="3" y1="19" x2="21" y2="19"/></svg>

{%- elif name == "caretaker" -%}
<svg {{ common | safe }}><circle cx="12" cy="8" r="3.5"/><path d="M5 20c0-4 3-6 7-6s7 2 7 6"/><polyline points="9.5 15.5 11.5 17.5 15 13.5"/></svg>

{%- elif name == "leaf" -%}
<svg {{ common | safe }}><path d="M5 19c8 0 13-5 13-13 0-1 0-2-0.3-3C9 3.5 5 8.5 5 15c0 1.5 0.2 3 0.2 3Z"/><path d="M5 19c3-3 5-6 6-11"/></svg>

{%- elif name == "cake" -%}
<svg {{ common | safe }}><path d="M4 21v-7a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v7"/><line x1="4" y1="17" x2="20" y2="17"/><line x1="8" y1="12" x2="8" y2="8"/><line x1="12" y1="12" x2="12" y2="8"/><line x1="16" y1="12" x2="16" y2="8"/><path d="M8 5c0 1-1 1-1 2s1 1 1 2" /><path d="M12 5c0 1-1 1-1 2s1 1 1 2" /><path d="M16 5c0 1-1 1-1 2s1 1 1 2" /></svg>

{%- elif name == "heart" -%}
<svg {{ common | safe }}><path d="M12 20s-7.5-4.6-10-9.5C0.6 6.8 3 3.5 6.5 3.5c2 0 3.8 1.2 5.5 3.3 1.7-2.1 3.5-3.3 5.5-3.3 3.5 0 5.9 3.3 4.5 7-2.5 4.9-10 9.5-10 9.5Z"/></svg>

{%- elif name == "flower" -%}
<svg {{ common | safe }}><circle cx="12" cy="12" r="2.3"/><circle cx="12" cy="6" r="2.5"/><circle cx="12" cy="18" r="2.5"/><circle cx="6" cy="12" r="2.5"/><circle cx="18" cy="12" r="2.5"/><line x1="12" y1="18" x2="12" y2="22"/></svg>

{%- elif name == "sparkle" -%}
<svg {{ common | safe }}><path d="M12 3v4M12 17v4M3 12h4M17 12h4"/><path d="M7 7l2 2M15 15l2 2M17 7l-2 2M9 15l-2 2"/></svg>

{%- elif name == "sparkles" -%}
<svg {{ common | safe }}><path d="M12 3c0.6 3 2 4.4 5 5-3 0.6-4.4 2-5 5-0.6-3-2-4.4-5-5 3-0.6 4.4-2 5-5Z"/><path d="M19 15c0.3 1.4 1 2.1 2.4 2.4-1.4 0.3-2.1 1-2.4 2.4-0.3-1.4-1-2.1-2.4-2.4 1.4-0.3 2.1-1 2.4-2.4Z"/></svg>

{%- elif name == "music" -%}
<svg {{ common | safe }}><path d="M9 18V5l11-2v13"/><circle cx="6.5" cy="18" r="2.5"/><circle cx="17.5" cy="16" r="2.5"/></svg>

{%- elif name == "rings" -%}
<svg {{ common | safe }}><circle cx="9" cy="13" r="4.5"/><circle cx="15" cy="13" r="4.5"/><path d="M12 5l1.5 3h-3L12 5Z"/></svg>

{%- elif name == "garland" -%}
<svg {{ common | safe }}><path d="M3 7c3 3 15 3 18 0"/><circle cx="6" cy="10" r="1.3" fill="currentColor" stroke="none"/><circle cx="10.5" cy="12.3" r="1.3" fill="currentColor" stroke="none"/><circle cx="15.5" cy="12.3" r="1.3" fill="currentColor" stroke="none"/><circle cx="20" cy="10" r="1.3" fill="currentColor" stroke="none"/><circle cx="13" cy="13.6" r="1.3" fill="currentColor" stroke="none"/></svg>

{%- elif name == "briefcase" -%}
<svg {{ common | safe }}><rect x="3" y="8" width="18" height="11" rx="2"/><path d="M8 8V6a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="3" y1="13" x2="21" y2="13"/></svg>

{%- elif name == "sun" -%}
<svg {{ common | safe }}><circle cx="12" cy="12" r="4.5"/><line x1="12" y1="2.5" x2="12" y2="5"/><line x1="12" y1="19" x2="12" y2="21.5"/><line x1="2.5" y1="12" x2="5" y2="12"/><line x1="19" y1="12" x2="21.5" y2="12"/><line x1="5" y1="5" x2="6.8" y2="6.8"/><line x1="17.2" y1="17.2" x2="19" y2="19"/><line x1="19" y1="5" x2="17.2" y2="6.8"/><line x1="6.8" y1="17.2" x2="5" y2="19"/></svg>

{%- elif name == "beach" -%}
<svg {{ common | safe }}><path d="M2 21c4-2 16-2 20 0"/><path d="M12 21c0-7 3-10.5 8-12-1 5-4 9-8 12Z"/><line x1="12" y1="12" x2="8" y2="8"/></svg>

{%- elif name == "pagoda" -%}
<svg {{ common | safe }}><line x1="12" y1="2" x2="12" y2="5"/><path d="M5 9h14l-2-3H7l-2 3Z"/><path d="M3 14h18l-2.5-4H5.5L3 14Z"/><path d="M2 21h20l-2.5-5.5H4.5L2 21Z"/></svg>

{%- elif name == "ferris-wheel" -%}
<svg {{ common | safe }}><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none"/><line x1="12" y1="4" x2="12" y2="20"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="6.3" y1="6.3" x2="17.7" y2="17.7"/><line x1="17.7" y1="6.3" x2="6.3" y2="17.7"/><line x1="12" y1="20" x2="12" y2="22"/></svg>

{%- elif name == "ferry" -%}
<svg {{ common | safe }}><path d="M4 14h16l-2 6H6l-2-6Z"/><path d="M6 14V8h12v6"/><line x1="12" y1="8" x2="12" y2="3"/><path d="M9 3h6"/><path d="M2 20c1.5 1 3 1 4.5 0s3-1 4.5 0 3 1 4.5 0 3-1 4.5 0"/></svg>

{%- elif name == "shrine" -%}
<svg {{ common | safe }}><path d="M12 2v3"/><path d="M4 9h16l-2-4H6L4 9Z"/><rect x="6" y="9" width="12" height="9"/><path d="M6 21l1-3h10l1 3"/><line x1="12" y1="9" x2="12" y2="18"/></svg>

{%- elif name == "rickshaw" -%}
<svg {{ common | safe }}><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/><path d="M4 18h2l2-8h8l3 5h2"/><path d="M8 10V6h4v4"/><path d="M9 18h7"/></svg>

{%- elif name == "train" -%}
<svg {{ common | safe }}><rect x="5" y="3" width="14" height="13" rx="4"/><line x1="5" y1="10" x2="19" y2="10"/><line x1="9" y1="19" x2="7" y2="22"/><line x1="15" y1="19" x2="17" y2="22"/><circle cx="8.5" cy="13" r="0.8" fill="currentColor" stroke="none"/><circle cx="15.5" cy="13" r="0.8" fill="currentColor" stroke="none"/></svg>

{%- elif name == "navigation" -%}
<svg {{ common | safe }}><polygon points="12 2 20 20 12 16 4 20 12 2"/></svg>

{%- elif name == "open-in-new" -%}
<svg {{ common | safe }}><path d="M14 4h6v6"/><line x1="20" y1="4" x2="11" y2="13"/><path d="M19 14v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4"/></svg>

{%- elif name == "star" -%}
<svg {{ common | safe }}><polygon points="12 2.5 14.8 9 21.9 9.6 16.5 14.2 18.2 21.2 12 17.4 5.8 21.2 7.5 14.2 2.1 9.6 9.2 9 12 2.5" fill="currentColor" stroke="none"/></svg>

{%- elif name == "clock" -%}
<svg {{ common | safe }}><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 16 14"/></svg>

{%- elif name == "load" -%}
<svg {{ common | safe }}><path d="M3 12a9 9 0 1 1 3 6.7"/><polyline points="3 16 3 21 8 21"/></svg>

{%- elif name == "lock" -%}
<svg {{ common | safe }}><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>

{%- elif name == "users" -%}
<svg {{ common | safe }}><circle cx="9" cy="8" r="3"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><circle cx="17" cy="9" r="2.3"/><path d="M15.5 12.2c2 .4 3.5 2.3 3.5 4.4"/></svg>

{%- elif name == "racket" -%}
<svg {{ common | safe }}><ellipse cx="9" cy="8" rx="6" ry="6.5"/><line x1="9" y1="5" x2="9" y2="11"/><line x1="6" y1="8" x2="12" y2="8"/><line x1="13.2" y1="12.2" x2="20" y2="19"/></svg>

{%- elif name == "utensils" -%}
<svg {{ common | safe }}><path d="M7 3v7a2 2 0 0 1-2 2v0"/><path d="M5 3v7"/><path d="M9 3v7"/><line x1="7" y1="12" x2="7" y2="21"/><path d="M17 3c-1.7 0-3 2-3 5s1.3 5 3 5v8"/></svg>

{%- elif name == "car" -%}
<svg {{ common | safe }}><path d="M4 16V12l2-5h12l2 5v4"/><path d="M4 16h16"/><circle cx="7.5" cy="17.5" r="1.6"/><circle cx="16.5" cy="17.5" r="1.6"/><line x1="7" y1="10" x2="17" y2="10"/></svg>

{%- else -%}
<svg {{ common | safe }}><circle cx="12" cy="12" r="9"/></svg>
{%- endif -%}
{% endmacro %}
