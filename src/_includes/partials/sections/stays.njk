{% from "partials/icons.njk" import icon %}
<section class="section section--alt" id="stays">
  <div class="container">
    <div class="stays__grid">
      <div class="stays__media">
        {% set staysImage = gallery.slides | staysSlide %}
        {% image staysImage.file, staysImage.alt, { widths: [480, 768, 1080], sizes: "(min-width: 1024px) 45vw, 100vw" } %}
      </div>

      <div class="stays__content">
        <span class="eyebrow">{{ copy.stays.eyebrow }}</span>
        <h2>{{ copy.stays.heading }}</h2>
        <p class="stays__intro">{{ copy.stays.intro }}</p>

        <ul class="stays__tiles">
          {% for tile in copy.stays.tiles %}
          <li class="stays-tile">
            {{ icon(tile.icon) }}
            <span class="stays-tile__text">
              <span class="stays-tile__label">{{ tile.label }}</span>
              <span class="stays-tile__sub">{{ tile.sub }}</span>
            </span>
          </li>
          {% endfor %}
        </ul>

        <div class="stays__chips">
          <span class="stays__chip">
            {{ icon("clock") }}
            {% if site.checkIn | isSet and site.checkOut | isSet %}{{ site.checkIn }}&ndash;{{ site.checkOut }}{% else %}{{ copy.stays.chipFlexibleTimes }}{% endif %}
          </span>
          <span class="stays__chip">
            <span class="stays__chip-symbol" aria-hidden="true">&#8377;</span>
            {{ copy.stays.chipRates }}
          </span>
        </div>

        <div class="stays__ctas">
          <a class="btn btn--primary" href="{{ site.whatsappNumber | whatsappUrl(copy.whatsappMessages.stay) }}" target="_blank" rel="noopener" data-cta="whatsapp" data-cta-location="stays">
            {{ icon("chat") }} {{ copy.stays.ctaWhatsapp }}
          </a>
          <a class="btn btn--outline" href="tel:{{ site.phoneE164 }}" data-cta="call" data-cta-location="stays">
            {{ icon("phone") }} {{ copy.stays.ctaCall }}
          </a>
          {% if site.airbnbUrl | isSet %}
          <a class="btn btn--outline" href="{{ site.airbnbUrl }}" target="_blank" rel="noopener" aria-label="{{ copy.stays.airbnbAriaLabel }}" data-cta="airbnb" data-cta-location="stays">
            {{ icon("open-in-new") }} {{ copy.stays.ctaAirbnb }}
          </a>
          {% endif %}
        </div>

        <p class="stays__microcopy">{{ copy.stays.microcopy }}</p>
      </div>
    </div>
  </div>
</section>
