{% from "partials/icons.njk" import icon %}
<section class="section section--alt" id="stays">
  <div class="container">
    <div class="stays__grid">
      <div>
        <span class="eyebrow">{{ copy.stays.eyebrow }}</span>
        <h2>{{ copy.stays.heading }}</h2>
        <p class="stays__intro">{{ copy.stays.intro }}</p>

        <div class="stays__facts">
          <div class="fact-card">
            <span class="fact-card__label">{{ copy.stays.checkInLabel }}</span>
            <span class="fact-card__value">{% if site.checkIn | isSet %}{{ site.checkIn }}{% else %}Ask us{% endif %}</span>
          </div>
          <div class="fact-card">
            <span class="fact-card__label">{{ copy.stays.checkOutLabel }}</span>
            <span class="fact-card__value">{% if site.checkOut | isSet %}{{ site.checkOut }}{% else %}Ask us{% endif %}</span>
          </div>
        </div>

        <ul class="check-list">
          {% for line in copy.stays.included %}
          <li>{{ icon("check-circle") }} <span>{{ line }}</span></li>
          {% endfor %}
        </ul>

        <p class="stays__price">
          {% if site.showPrices %}{{ copy.stays.priceNoteShown }}{% else %}{{ copy.stays.priceNote }}{% endif %}
          &middot; {{ copy.stays.capacityNote }}
        </p>
      </div>

      <div class="stays__media">
        {% set staysImage = gallery.slides | visibleSlides | last %}
        {% image staysImage.file, staysImage.alt, { widths: [480, 768, 1080], sizes: "(min-width: 1024px) 40vw, 100vw" } %}
        <div class="stays__badge">
          <strong>Exclusive booking</strong>
          <p>The entire villa is rented to one group at a time, so your stay is completely private.</p>
        </div>
      </div>
    </div>
  </div>
</section>
