{% from "partials/icons.njk" import icon %}
<section class="section" id="celebrations">
  <div class="container">
    <div class="section__head section__head--center">
      <span class="eyebrow">{{ copy.celebrations.eyebrow }}</span>
      <h2>{{ copy.celebrations.heading }}</h2>
      <p>{{ copy.celebrations.intro }}</p>
    </div>

    <div class="celebrations__grid">
      {% for card in copy.celebrations.cards %}
      <div class="event-card">
        <div>
          {{ icon(card.icon, "event-card__icon") }}
          <h3>{{ card.title }}</h3>
          <p>{{ card.line }}</p>
        </div>
        <a class="event-card__cta" href="{{ site.whatsappNumber | whatsappUrl(copy.whatsappMessages.event | replace('{event}', card.waLabel)) }}" target="_blank" rel="noopener" data-cta="whatsapp" data-cta-location="celebrations_{{ card.key }}">
          Book on WhatsApp {{ icon("arrow-right") }}
        </a>
      </div>
      {% endfor %}
    </div>

    <p class="celebrations__note">&#10024; {{ copy.celebrations.partnerNote }}</p>
  </div>
</section>
