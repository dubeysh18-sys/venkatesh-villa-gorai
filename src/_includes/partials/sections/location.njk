{% from "partials/icons.njk" import icon %}
<section class="section" id="location">
  <div class="container">
    <div class="location__grid">
      <div>
        <span class="eyebrow">{{ copy.location.eyebrow }}</span>
        <h2>{{ copy.location.heading }}</h2>
        <p class="location__intro">{{ copy.location.intro }}</p>

        <div class="howto-steps">
          {% for step in copy.location.howToReachSteps %}
          <div class="howto-step">
            {{ icon(step.icon) }}
            <span class="howto-step__label">{{ step.label }}</span>
            <p>{{ step.text }}</p>
          </div>
          {% endfor %}
        </div>

        <p class="location__by-car">{{ icon("navigation") }} {{ copy.location.byCarNote }}</p>

        <div class="location__actions">
          <a class="btn btn--primary" href="{{ site.googleDirectionsUrl }}" target="_blank" rel="noopener">
            {{ icon("navigation") }} {{ copy.location.mapCtaDirections }}
          </a>
        </div>
      </div>

      <div>
        <div class="map-embed-direct">
          <iframe title="Map showing Venkatesh Villa Gorai location" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="https://www.google.com/maps?q={{ site.geo.lat }},{{ site.geo.lng }}&hl=en&z=15&output=embed"></iframe>
        </div>
      </div>
    </div>
  </div>
</section>
