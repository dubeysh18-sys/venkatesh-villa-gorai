{% from "partials/icons.njk" import icon %}
<section class="section" id="location">
  <div class="container">
    <div class="location__grid">
      <div>
        <span class="eyebrow">{{ copy.location.eyebrow }}</span>
        <h2>{{ copy.location.heading }}</h2>
        <p class="location__intro">{{ copy.location.intro }}</p>

        <h3 class="journey__heading">{{ copy.location.stepperHeading }}</h3>
        <ol class="journey" aria-label="Route from Borivali station to Venkatesh Villa">
          {% for stop in copy.location.journey %}
          <li class="journey__stop">
            {% if stop.connectorMode %}
            <div class="journey__connector">
              <span class="journey__connector-line" aria-hidden="true"></span>
              <span class="journey__connector-label">{{ stop.connectorMode }}{% if stop.connectorTime %} &middot; {{ stop.connectorTime }}{% endif %}</span>
            </div>
            {% endif %}
            <div class="journey__node">
              {{ icon(stop.icon) }}
              <span class="journey__node-label">{{ stop.label }}</span>
            </div>
          </li>
          {% endfor %}
        </ol>

        <div class="by-car">
          <h3 class="by-car__heading">{{ copy.location.byCarHeading }}</h3>
          <p>{{ copy.location.byCarNote }}</p>
          <a class="btn btn--primary" href="{{ site.googleDirectionsUrl }}" target="_blank" rel="noopener">
            {{ icon("navigation") }} {{ copy.location.mapCtaDirections }}
          </a>
        </div>
      </div>

      <div>
        <div class="map-embed-direct">
          <iframe title="Map showing Venkatesh Villa Gorai location" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="https://www.google.com/maps?q={{ site.geo.lat }},{{ site.geo.lng }}&hl=en&z=15&output=embed"></iframe>
        </div>
      </div>
    </div>
  </div>
</section>
