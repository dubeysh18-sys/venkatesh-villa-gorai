{% from "partials/icons.njk" import icon %}
<section class="section" id="location">
  <div class="container">
    <div class="location__grid">
      <div>
        <span class="eyebrow">{{ copy.location.eyebrow }}</span>
        <h2>{{ copy.location.heading }}</h2>
        <p class="location__intro">{{ copy.location.intro }}</p>

        <div class="howto-steps">
          {% for step in copy.location.howToReachSteps %}
          <div class="howto-step">
            {{ icon(step.icon) }}
            <span class="howto-step__label">{{ step.label }}</span>
            <p>{{ step.text }}</p>
          </div>
          {% endfor %}
        </div>

        <p class="location__by-car">{{ icon("navigation") }} {{ copy.location.byCarNote }}</p>
        <p class="location__beach-note">{{ icon("beach") }} {{ copy.location.beachNote }}</p>

        <div class="location__actions">
          <a class="btn btn--primary" href="{{ site.googleMapsUrl }}" target="_blank" rel="noopener">
            {{ icon("open-in-new") }} {{ copy.location.mapCtaOpen }}
          </a>
          <a class="btn btn--secondary" href="{{ site.googleDirectionsUrl }}" target="_blank" rel="noopener">
            {{ icon("navigation") }} {{ copy.location.mapCtaDirections }}
          </a>
        </div>
      </div>

      <div>
        <div class="map-embed" data-map-embed>
          <iframe title="Map showing the location of {{ site.name }}" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="about:blank" data-map-src="https://www.google.com/maps?q={{ site.geo.lat }},{{ site.geo.lng }}&hl=en&z=15&output=embed"></iframe>
        </div>
        <div class="map-facade">
          {% set mapImage = gallery.slides | findSlideByFile("venkatesh-villa-gorai-grounds-aerial.webp") %}
          {% if not mapImage %}{% set mapImage = gallery.slides | heroSlide %}{% endif %}
          {% image mapImage.file, "", { widths: [480, 768, 1080], sizes: "(min-width: 1024px) 40vw, 100vw" } %}
          <div class="map-facade__overlay">
            <div class="map-facade__card">
              {{ icon("map-pin") }}
              <h3>{{ site.name }}</h3>
              <p>{{ site.address.locality }}, {{ site.address.city }}</p>
              <button type="button" class="btn btn--primary btn--block" data-map-load>
                {{ icon("load") }} {{ copy.location.mapCtaLoad }}
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
